# Auth E2E credentials + topology. Copy to `e2e/.env` (gitignored) and fill in.
# Seeded verified CUSTOMER on server_2 (see e2e/README.md for the seed steps).
E2E_USER_EMAIL=testcustomer@flavorstack.local
E2E_USER_PASSWORD=Test@1234

# Seeded platform ADMIN (Phase 11 admin-ops specs). Provisioned out-of-band by
# the globalSetup seeder; defaults match the documented local admin seed.
# E2E_ADMIN_EMAIL=admin@flavorstack.local
# E2E_ADMIN_PASSWORD=Admin@1234

# Optional overrides (defaults shown):
# Dev app under test (own port; server_2 owns :3000).
# E2E_BASE_URL=http://localhost:3100
# Backend the dev proxy forwards /api/v1/* to (server_2 gateway).
# API_PROXY_TARGET=http://localhost:3000

# --- CI env contract (Batch 12.2) ---
# The out-of-band seeders `docker exec` into the server_2 compose containers to
# read OTP codes from Redis (Phase 2 register/reset spec) and write Mongo
# (promote ADMIN / flip isEmailVerified / insert PENDING reviews). The names
# follow the compose PROJECT name: the E2E workflow pins `-p server_2`, so the
# defaults below resolve. Override if your local compose project name differs.
# E2E_MONGO_CONTAINER=server_2-mongo-1
# E2E_REDIS_CONTAINER=server_2-redis-1
# E2E_MONGO_DB=flavorstack

# In CI, ALLOWED_ORIGINS on server_2 must include the dev-app origin
# (http://localhost:3100) alongside http://localhost:3000 — the E2E workflow
# writes this into server_2/.env when it synthesizes the stack config.
