# Same-origin base path for the frontend API client; the Next.js rewrite
# proxy (see next.config.ts) forwards these requests to API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend server_2 origin that the dev rewrite proxy forwards /api/v1/* to.
API_PROXY_TARGET=http://localhost:8000

# server_2 origin for the live-tracking Socket.IO `/tracking` namespace (Phase 7,
# Batch 7.4). The Next rewrite only proxies /api/v1, not the /socket.io path, so
# the WS connects directly. Empty → same-origin.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Dual-rating, verified-purchase reviews (Phase 9). Default off; flips on at the
# end of the phase.
NEXT_PUBLIC_FEATURE_REVIEWS=false

# Platform-admin ops: review moderation + fulfillment dashboard (Phase 11).
# Default off; flips on at the end of the phase (Batch 11.3).
NEXT_PUBLIC_FEATURE_ADMIN_OPS=false

# Observability (Phase 12, Batch 12.4) — OPTIONAL. The FE reporter
# (lib/observability/reporter.ts) is a vendor-agnostic no-op until a Sentry DSN
# is set; absent → pure no-op (no @sentry import, no network). To enable Sentry
# in an environment: set the DSN below, `npm i @sentry/nextjs`, and wire source
# maps in the build. Leave UNSET for local dev / tests.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENV=development

# NOTE (Phase 12, Batch 12.3): for the SAME-ORIGIN production build see
# `.env.production.example`. There `NEXT_PUBLIC_SOCKET_URL` is EMPTY (the
# `/tracking` socket connects to the page origin, which nginx proxies to the
# api with the WS Upgrade headers) and these `NEXT_PUBLIC_*` values are baked in
# as Docker build args, not runtime env.
