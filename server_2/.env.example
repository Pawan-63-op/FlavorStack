// All required env vars — safe to commit (no secrets)

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES_PER_REQUEST=3

# API / OutboxWorker only
MONGO_URI=mongodb://127.0.0.1:27017/flavorstack?replicaSet=rs0
PORT=3000

# JWT (API + OutboxWorker)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Email (API + OutboxWorker enqueue path, EmailWorker send path)
RESEND_API_KEY=
EMAIL_FROM=no-reply@flavorstack.app
APP_BASE_URL=http://localhost:3000

# Worker process selector: outbox | email | notification
WORKER_TYPE=

# ── Transactional outbox relay (src/config/outbox.ts) ─────────────────────────
# OUTBOX_POLL_INTERVAL_MS  gap between batches; the timer re-arms after a batch
#                          finishes, so batches never overlap. (default 2000)
# OUTBOX_BATCH_SIZE        max due rows drained per tick. (default 100)
# OUTBOX_MAX_RETRIES       attempts before a row is marked terminal FAILED. (default 5)
# OUTBOX_BACKOFF_BASE_MS   base of the exponential retry backoff, plus jitter. (default 1000)
# OUTBOX_LEASE_MS          how long a claimed (PROCESSING) row may stay locked
#                          before the reaper returns it to PENDING. Must exceed
#                          the slowest expected handler. (default 60000)
OUTBOX_POLL_INTERVAL_MS=
OUTBOX_BATCH_SIZE=
OUTBOX_MAX_RETRIES=
OUTBOX_BACKOFF_BASE_MS=
OUTBOX_LEASE_MS=

# ── Production values (Phase 12, Batch 12.3 — same-origin HTTPS topology) ──────
# In prod the FE + /api/v1 + Socket.IO are served under ONE origin via nginx
# (deploy/), so the frozen `sameSite:'lax'` cookies work without a backend
# change. Set these for the deploy/docker-compose.prod.yml stack:
#
#   NODE_ENV=production
#     → server_2 flags the auth cookies `Secure` (cookies.ts). Requires the real
#       HTTPS edge that nginx terminates. (Set per-service in the prod compose.)
#
#   ALLOWED_ORIGINS=https://your.domain
#     → the single public origin (HTTP CORS allow-list, config/cors.ts).
#       Same-origin in prod means CORS is effectively moot, but lock it down.
#
#   REALTIME_CORS_ORIGIN=https://your.domain
#     → Socket.IO handshake origin (config/realtime.ts; defaults to '*' — lock it
#       to the single public origin in prod).
#
#   JWT_ACCESS_TTL_SECONDS=900        # 15-min access token
#   JWT_REFRESH_TTL_SECONDS=2592000   # 30-day path-scoped (/api/v1/auth/refresh) refresh token
#
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY must be a real RS256 keypair (PEM; single-line
# with literal \n is accepted — auth.ts expands it).

# Cloudinary image storage (catalog). When unset, the API uses an in-memory fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
