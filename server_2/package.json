    "test:engagement": "jest --runInBand src/tests/unit/domain/engagement/ src/tests/unit/application/engagement/",
    "test:fulfillment": "jest --runInBand src/tests/unit/domain/fulfillment/ src/tests/unit/application/fulfillment/",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:integration:redis": "jest --config jest.integration.redis.config.ts --runInBand",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:catalog": "jest --config jest.coverage.catalog.config.ts --runInBand",
    "worker:relay": "WORKER_TYPE=relay node dist/workers/index.js",
    "worker:jobs": "WORKER_TYPE=jobs node dist/workers/index.js"
  },
  "keywords": [],
